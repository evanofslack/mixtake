# Copy to .env next to docker-compose.yaml and edit. Apply changes with `docker compose up -d`;
# nothing here needs a rebuild. Every line is optional; the values shown are the defaults.

# --- analyzer sizing ---
# uvicorn worker processes in the analyzer. Each one analyses one track at a time and needs about
# 1.7 GB of RAM once warm, so an 8 GB VPS runs 2.
ANALYZER_WORKERS=2
# tracks analysed at once across all mixes. Keep ANALYZE_CONCURRENCY >= ANALYZER_WORKERS so every
# worker stays busy; extra requests queue in the analyzer.
ANALYZE_CONCURRENCY=4
# Spotify requests at once, per mix
SPOTIFY_CONCURRENCY=4

# --- limits ---
# new mixes per client ip, and across all clients
RATE_LIMIT_PER_MINUTE=10
GLOBAL_RATE_LIMIT_PER_MINUTE=60
# most tracks accepted from a paste
MAX_PASTE_TRACKS=300

# --- proxy ---
# where the real client ip is. CF-Connecting-IP behind cloudflare + caddy; X-Forwarded-For when
# caddy faces clients directly
CLIENT_IP_HEADER=CF-Connecting-IP

# --- host ports (bound to 127.0.0.1 only) ---
MIXTAKE_PORT=8080
MIXTAKE_METRICS_PORT=9090

# --- images ---
# pin a release, e.g. 2.0.0 or a short sha, instead of latest
MIXTAKE_TAG=latest
ANALYZER_TAG=latest

# --- logs ---
# debug, info, warn, error; text or json
LOG_LEVEL=info
LOG_FORMAT=json
ANALYZER_LOG_LEVEL=info
